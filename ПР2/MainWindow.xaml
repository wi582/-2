<Window x:Class="ПР2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПР2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="/Resources/logo2.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#050166">
            <Button x:Name="btnBack" Content="Назад"
                    HorizontalAlignment="Right" Width="80"
                    Click="btnBack_Click"/>
            <Image Width="45" Height="45" HorizontalAlignment="Left" Margin="5" Source="/Resources/logo.png"/>
            <TextBlock Text="FitLife"
               Foreground="Yellow"
               FontSize="20"
               FontWeight="Medium"
               FontFamily="Comic Sans MS"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Margin="45,0,0,0"/>
        </Grid>

        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden"
       ContentRendered="FrmMain_ContentRendered"/>
    </Grid>
</Window>
